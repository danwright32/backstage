# Per machine, never "do not look": scripts/check-secrets.sh walks the directory
# rather than git ls-files, precisely because the highest risk content on a disk
# is what this file excludes.
.DS_Store
.build/
.swiftpm/
*.xcuserdatad
xcuserdata/

# Python's own compiled cache, written beside scripts/lib/secret_rules.py the
# first time a guard imports it. A build product of running a check, never
# anything written here (backstage#11).
__pycache__/
*.pyc
